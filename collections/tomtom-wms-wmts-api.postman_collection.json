        {
          "id": "f708d51b-a1c4-4232-b89a-bd78df3e997e",
          "name": "GetMap",
          "request": {
            "name": "GetMap",
            "description": {
              "content": "The GetMap call implements the Web Map Service 1.1.1 standard\nto access TomTom raster map tiles. This service is described\nin the response to the GetCapabilities API call.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "map",
                ":versionNumber",
                "wms",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "request",
                  "value": "<string>",
                  "description": "(Required) Request type"
                },
                {
                  "disabled": false,
                  "key": "srs",
                  "value": "<string>",
                  "description": "(Required) Projection used in describing the <b>bbox</b> EPSG:3857 is\nrecommended, particularly at higher zoom levels. (Note that\nEPSG:3857 is functionally equivalent to EPSG:900913/EPSG:3785)"
                },
                {
                  "disabled": false,
                  "key": "bbox",
                  "value": "<string>",
                  "description": "(Required) Bounding box in the projection stated in <b>srs</b>\n(minLon,minLat,maxLon,maxLat)"
                },
                {
                  "disabled": false,
                  "key": "width",
                  "value": "<integer>",
                  "description": "(Required) Width of the resulting image, in pixels Maximum value is 2048"
                },
                {
                  "disabled": false,
                  "key": "height",
                  "value": "<integer>",
                  "description": "(Required) Height of the resulting image, in pixels Maximum value is 2048"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "(Required) Image format to be returned"
                },
                {
                  "disabled": false,
                  "key": "layers",
                  "value": "<string>",
                  "description": "(Required) Map layers requested Currently only the basic layer is available"
                },
                {
                  "disabled": false,
                  "key": "styles",
                  "value": "<string>",
                  "description": "Map styles to be returned. Currently, no styles are available. This\nparameter is present for forward compatibility; it must be used and\nleft blank."
                },
                {
                  "disabled": false,
                  "key": "service",
                  "value": "<string>",
                  "description": "Service type"
                },
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>",
                  "description": "(Required) WMS service version"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "versionNumber",
                  "description": "(Required) Version of the service to call. The current version is 1"
                }
